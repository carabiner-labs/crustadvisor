{#- CrustAdvisor enrichment preamble. enrich.py fills in the persona and the
    vendor's own chat template (the two placeholders below, named only there).
    The preamble rewrites `messages` so the persona is always the first system
    block; anything the app sends as a system message (the menu) is appended
    to it. The vendor template then renders as it always does. -#}
{%- set __persona = __PERSONA__ -%}
{%- if messages and messages[0]['role'] == 'system' -%}
{%- set messages = [{'role': 'system', 'content': __persona ~ '\n\n' ~ messages[0]['content']}] + messages[1:] -%}
{%- else -%}
{%- set messages = [{'role': 'system', 'content': __persona}] + messages -%}
{%- endif -%}
__UPSTREAM_TEMPLATE__
